{
  "id": "class", "name": "Java class file", "extensions": ["class"],
  "match": [[{ "offset": 0, "hex": "CA FE BA BE" }, { "offset": 6, "type": "u16", "endian": "big", "min": 45, "max": 200 }]],
  "endian": "big",
  "structs": {
    "File": [
      { "name": "magic", "type": "u32", "format": "hex", "expect": 3405691582 },
      { "name": "minor_version", "type": "u16" },
      { "name": "major_version", "type": "u16", "enum": { "45": "Java 1.1", "46": "Java 1.2", "47": "Java 1.3", "48": "Java 1.4", "49": "Java 5", "50": "Java 6", "51": "Java 7", "52": "Java 8", "53": "Java 9", "54": "Java 10", "55": "Java 11", "56": "Java 12", "57": "Java 13", "58": "Java 14", "59": "Java 15", "60": "Java 16", "61": "Java 17", "62": "Java 18", "63": "Java 19", "64": "Java 20", "65": "Java 21", "66": "Java 22", "67": "Java 23", "68": "Java 24", "69": "Java 25" } },
      { "name": "constant_pool_count", "type": "u16" },
      { "name": "constant_pool", "type": "CpEntry", "count": 65535, "while": "constant_pool_count > 1 && (!defined(_) || _.next_slot < constant_pool_count)" },
      { "name": "access_flags", "type": "u16", "flags": "Access" },
      { "name": "this_class", "type": "u16" }, { "name": "super_class", "type": "u16" },
      { "name": "interfaces_count", "type": "u16" }, { "name": "interfaces", "type": "u16", "count": "interfaces_count" },
      { "name": "fields_count", "type": "u16" }, { "name": "fields", "type": "Member", "count": "fields_count" },
      { "name": "methods_count", "type": "u16" }, { "name": "methods", "type": "Member", "count": "methods_count" },
      { "name": "attributes_count", "type": "u16" }, { "name": "attributes", "type": "Attribute", "count": "attributes_count" }
    ],
    "CpEntry": { "label": "'#' + slot + ' ' + (tag == 1 ? body.text : tag == 7 ? 'Class #' + body.name_index : tag == 8 ? 'String #' + body.string_index : tag == 12 ? 'NameAndType' : tag == 10 ? 'Methodref' : tag == 9 ? 'Fieldref' : 'tag ' + tag)", "fields": [
      { "name": "slot", "value": "i == 0 ? 1 : constant_pool[i - 1].next_slot", "hidden": true },
      { "name": "tag", "type": "u8", "enum": { "1": "Utf8", "3": "Integer", "4": "Float", "5": "Long", "6": "Double", "7": "Class", "8": "String", "9": "Fieldref", "10": "Methodref", "11": "InterfaceMethodref", "12": "NameAndType", "15": "MethodHandle", "16": "MethodType", "17": "Dynamic", "18": "InvokeDynamic", "19": "Module", "20": "Package" } },
      { "name": "next_slot", "value": "slot + (tag == 5 || tag == 6 ? 2 : 1)", "hidden": true },
      { "name": "body", "type": { "switch": "tag", "cases": { "1": "Utf8", "3": "Int", "4": "Flt", "5": "Lng", "6": "Dbl", "7": "Idx1", "8": "Str", "16": "Idx1", "19": "Idx1", "20": "Idx1", "9": "Ref", "10": "Ref", "11": "Ref", "12": "Nat", "15": "Handle", "17": "Dyn", "18": "Dyn" }, "default": "Bad" } }
    ] },
    "Bad": [ { "name": "unknown_tag", "type": "bytes", "length": "-1" } ],
    "Utf8": [ { "name": "length", "type": "u16" }, { "name": "text", "type": "string", "length": "length" } ],
    "Int": [ { "name": "value", "type": "i32" } ], "Flt": [ { "name": "value", "type": "f32" } ],
    "Lng": [ { "name": "value", "type": "i64" } ], "Dbl": [ { "name": "value", "type": "f64" } ],
    "Idx1": [ { "name": "name_index", "type": "u16" } ],
    "Str": [ { "name": "string_index", "type": "u16" } ],
    "Ref": [ { "name": "class_index", "type": "u16" }, { "name": "name_and_type_index", "type": "u16" } ],
    "Nat": [ { "name": "name_index", "type": "u16" }, { "name": "descriptor_index", "type": "u16" } ],
    "Handle": [ { "name": "reference_kind", "type": "u8" }, { "name": "reference_index", "type": "u16" } ],
    "Dyn": [ { "name": "bootstrap_method_attr_index", "type": "u16" }, { "name": "name_and_type_index", "type": "u16" } ],
    "Member": { "label": "'name #' + name_index + ', descriptor #' + descriptor_index", "fields": [
      { "name": "access_flags", "type": "u16", "flags": "Access" }, { "name": "name_index", "type": "u16" }, { "name": "descriptor_index", "type": "u16" },
      { "name": "attributes_count", "type": "u16" }, { "name": "attributes", "type": "Attribute", "count": "attributes_count" }
    ] },
    "Attribute": { "label": "'name #' + name_index", "fields": [ { "name": "name_index", "type": "u16" }, { "name": "length", "type": "u32" }, { "name": "info", "type": "bytes", "length": "length" } ] }
  },
  "flags": { "Access": { "0x1": "public", "0x2": "private", "0x4": "protected", "0x8": "static", "0x10": "final", "0x20": "super/synchronized", "0x40": "volatile/bridge", "0x80": "transient/varargs", "0x100": "native", "0x200": "interface", "0x400": "abstract", "0x800": "strict", "0x1000": "synthetic", "0x2000": "annotation", "0x4000": "enum", "0x8000": "module" } }
}

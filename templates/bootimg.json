{
  "id": "bootimg", "name": "Android boot image (boot.img, recovery.img)", "extensions": [],
  "match": [[{ "offset": 0, "text": "ANDROID!" }]],
  "endian": "little",
  "structs": {
    "File": [
      { "name": "magic", "type": "char", "length": 8, "expect": "ANDROID!" },
      { "name": "hv", "hidden": true, "value": "size() >= 44 ? u32le(40) : 0" },
      { "name": "kernel_size", "type": "u32" },
      { "name": "kernel_addr", "type": "u32", "format": "hex", "if": "hv < 3" },
      { "name": "ramdisk_size", "type": "u32" },
      { "name": "ramdisk_addr", "type": "u32", "format": "hex", "if": "hv < 3" },
      { "name": "second_size", "type": "u32", "if": "hv < 3" },
      { "name": "second_addr", "type": "u32", "format": "hex", "if": "hv < 3" },
      { "name": "tags_addr", "type": "u32", "format": "hex", "if": "hv < 3" },
      { "name": "page_size", "type": "u32", "if": "hv < 3" },
      { "name": "os_version", "type": "u32", "format": "hex", "if": "hv >= 3" },
      { "name": "header_size", "type": "u32", "if": "hv >= 3" },
      { "name": "reserved", "type": "u32", "count": 4, "if": "hv >= 3" },
      { "name": "header_version", "type": "u32" },
      { "name": "os_version", "type": "u32", "format": "hex", "if": "hv < 3" },
      { "name": "name", "type": "char", "length": 16, "if": "hv < 3" },
      { "name": "cmdline", "type": "char", "length": 512, "if": "hv < 3" },
      { "name": "id", "type": "bytes", "length": 32, "if": "hv < 3", "comment": "SHA-1 or SHA-256 of the parts" },
      { "name": "extra_cmdline", "type": "char", "length": 1024, "if": "hv < 3" },
      { "name": "recovery_dtbo_size", "type": "u32", "if": "hv == 1 || hv == 2" },
      { "name": "recovery_dtbo_offset", "type": "u64", "format": "hex", "if": "hv == 1 || hv == 2" },
      { "name": "header_size", "type": "u32", "if": "hv == 1 || hv == 2" },
      { "name": "dtb_size", "type": "u32", "if": "hv == 2" },
      { "name": "dtb_addr", "type": "u64", "format": "hex", "if": "hv == 2" },
      { "name": "cmdline", "type": "char", "length": 1536, "if": "hv >= 3" },
      { "name": "signature_size", "type": "u32", "if": "hv >= 4" },
      { "name": "android_version", "value": "str((os_version >> 25) & 127) + '.' + str((os_version >> 18) & 127) + '.' + str((os_version >> 11) & 127)", "if": "os_version != 0" },
      { "name": "security_patch", "value": "str(((os_version >> 4) & 127) + 2000) + '-' + ((os_version & 15) < 10 ? '0' : '') + str(os_version & 15)", "if": "os_version != 0" },
      { "name": "page", "hidden": true, "value": "hv < 3 ? page_size : 4096" },
      { "name": "kernel_pages", "hidden": true, "value": "page > 0 ? (kernel_size + page - 1) // page : 0" },
      { "name": "ramdisk_pages", "hidden": true, "value": "page > 0 ? (ramdisk_size + page - 1) // page : 0" },
      { "name": "second_pages", "hidden": true, "value": "hv < 3 && page > 0 ? (second_size + page - 1) // page : 0" },
      { "name": "kernel", "type": "bytes", "length": "kernel_size", "at": "page", "peek": true, "if": "page > 0 && kernel_size > 0" },
      { "name": "ramdisk", "type": "bytes", "length": "ramdisk_size", "at": "page * (1 + kernel_pages)", "peek": true, "if": "page > 0 && ramdisk_size > 0" },
      { "name": "second", "type": "bytes", "length": "second_size", "at": "page * (1 + kernel_pages + ramdisk_pages)", "peek": true, "if": "hv < 3 && page > 0 && second_size > 0" },
      { "name": "recovery_dtbo", "type": "bytes", "length": "recovery_dtbo_size", "at": "recovery_dtbo_offset", "peek": true, "if": "(hv == 1 || hv == 2) && recovery_dtbo_size > 0" },
      { "name": "dtb", "type": "bytes", "length": "dtb_size", "at": "page * (1 + kernel_pages + ramdisk_pages + second_pages + (recovery_dtbo_size + page - 1) // max(page, 1))", "peek": true, "if": "hv == 2 && page > 0 && dtb_size > 0" }
    ]
  }
}
